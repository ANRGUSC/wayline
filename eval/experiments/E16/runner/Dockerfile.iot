# iot tasks on a Wayline warm runner. Build from the repo root:
#   docker build -f eval/experiments/E16/runner/Dockerfile.iot -t 192.168.1.163:5000/wl-runner-iot:latest .
# Python 3.12, as in the Ray image.
FROM python:3.12-slim
WORKDIR /app
COPY sdk/python/wl ./wl
COPY examples/iot-mission-snapshot-odag/tasks ./tasks
COPY eval/experiments/E16/runner/iot_stage.py ./stage.py
CMD ["python", "-m", "wl.runner", "--script", "/app/stage.py", "--cpus", "7.4"]
