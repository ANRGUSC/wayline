apiVersion: v1
kind: Pod
metadata:
  name: e10-ray-@@NODE@@
  namespace: wl-system
  labels: {app: e10-ray, role: worker}
spec:
  nodeName: @@NODE@@
  hostNetwork: true
  restartPolicy: Never
  containers:
  - name: ray
    image: 192.168.1.163:5000/wl-ray-baseline:2.58.0
    command: ["sh", "-c", "ray start --address 192.168.1.163:6379 --num-cpus 8 --object-manager-port 8076 --node-manager-port 8077 --min-worker-port 10002 --max-worker-port 10100 --block"]
