# A workload image with the E16 Argo stage wrapper added (argo_stage.py), so
# Argo runs the workload's own stage code. Build from the repo root, once per
# image the workload uses:
#   docker build -f eval/experiments/E18/argo/Dockerfile.stage --build-arg BASE=<registry>/wl-gdtm:latest -t <registry>/wl-gdtm-argo:latest .
ARG BASE
FROM ${BASE}
COPY eval/experiments/E18/argo/argo_stage.py /app/argo_stage.py
