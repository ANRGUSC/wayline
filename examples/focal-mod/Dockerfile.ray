# FOCAL on Ray (the E16 Ray baseline): the FOCAL image plus Ray and the E16
# FOCAL driver, so every Ray node has FOCAL's code and models. Build from the
# repo root:
#   docker build -f examples/focal-mod/Dockerfile.ray -t <registry>/wl-focal-ray:latest .
ARG BASE=192.168.1.163:5000/wl-focal:latest
FROM ${BASE}
ARG RAY=2.58.0
RUN pip install "ray[default]==${RAY}"
COPY examples/focal-mod/gen_focal.py eval/experiments/E16/ray/e16_ray_focal.py /app/
RUN python -c "import ray, focal_stages, gen_focal; print('ray', ray.__version__, 'focal ok')"
